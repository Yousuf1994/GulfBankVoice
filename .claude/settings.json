{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm test *)",
      "Bash(node -v)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(elevenlabs agents status *)",
      "Bash(elevenlabs agents pull *)",
      "Bash(elevenlabs agents list *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(elevenlabs agents push)",
      "Bash(elevenlabs agents push *)",
      "Bash(vercel *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(elevenlabs agents delete *)"
    ]
  }
}
