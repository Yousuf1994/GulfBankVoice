{
    "api_schema": {
        "method": "POST",
        "request_body_schema": {
            "description": "Request body for the webhook",
            "properties": {
                "customer_id": {
                    "type": "string",
                    "dynamic_variable": "customer_id"
                },
                "card_type": {
                    "type": "string",
                    "enum": ["credit", "debit"],
                    "description": "Type of card to issue."
                },
                "holder_name": {
                    "type": "string",
                    "description": "Full name of who the card is for."
                },
                "holder_relationship": {
                    "type": "string",
                    "description": "Relationship to the account holder, e.g. 'self', 'spouse', 'child'. Use 'self' if it's for the customer themselves."
                }
            },
            "required": ["card_type", "holder_name"],
            "type": "object"
        },
        "request_headers": {
            "Content-Type": "application/json",
            "X-Tool-Secret": { "env_var_label": "tool_secret" }
        },
        "url": "https://gulfbankvoice.vercel.app/api/tools/request-new-card"
    },
    "assignments": [],
    "description": "Issue a brand new card that isn't a replacement -- for example an additional supplementary card for a family member. Needs a fresh level 2 approval.",
    "disable_interruptions": false,
    "dynamic_variables": {
        "dynamic_variable_placeholders": {}
    },
    "force_pre_tool_speech": false,
    "name": "request_new_card",
    "response_timeout_secs": 15,
    "type": "webhook"
}
